# Mouse toggle handled by tmux: Ctrl-Space m

gtk-single-instance = false

keybind = super+enter=unbind

# Mac remap: physical Alt/Option is Super. Send tmux's Alt+hjkl sequences.
# Native Alt+hjkl continues to work on keyboards without this remap.
keybind = super+h=text:\x1bh
keybind = super+j=text:\x1bj
keybind = super+k=text:\x1bk
keybind = super+l=text:\x1bl

# fixes issues with sshing to Callisto
shell-integration-features = ssh-env,ssh-terminfo

# Linux terminal convention. Plain ctrl+c stays SIGINT.
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard

# Ghostty has no conditional binds, so this eats quoted-insert and nvim's
# visual-block. ctrl+q is vim's built-in alias for the latter.
keybind = ctrl+v=paste_from_clipboard

# No standard byte for ctrl+backspace; send ^W (delete word) so shells/TUIs agree.
keybind = ctrl+backspace=text:\x17

# Drops underlines lower in the cell: gap between the tmux todo header and its bar.
adjust-underline-position = 4

keybind = ctrl+shift+n=new_window
keybind = ctrl+shift+t=new_tab

# Ghostty splits: only consumed when a split exists that way; otherwise ctrl+hjkl reaches tmux.
keybind = performable:ctrl+h=goto_split:left
keybind = performable:ctrl+j=goto_split:down
keybind = performable:ctrl+k=goto_split:up
keybind = performable:ctrl+l=goto_split:right
