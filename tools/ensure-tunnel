#!/usr/bin/env bash
# Ensure an SSH tunnel is open for a given db, reopen via evaql if not.
# Usage: ensure-tunnel <db>
#   db: bim, finn, bim_stag, finn_stag
# Exit 0 if tunnel is up, 1 on failure.

set -euo pipefail

db="${1:-}"
if [[ -z "$db" ]]; then
    echo "Usage: ensure-tunnel <db>" >&2
    echo "  db: bim, finn, bim_stag, finn_stag" >&2
    exit 1
fi

case "$db" in
    bim|bim_prod)       port=24601; domain=bim;      env=production ;;
    finn|finn_prod)     port=24603; domain=finnegan;  env=production ;;
    bim_stag)           port=24602; domain=bim;      env=staging ;;
    finn_stag)          port=24604; domain=finnegan;  env=staging ;;
    *) echo "Unknown db: $db" >&2; exit 1 ;;
esac

# Already listening? Done.
if lsof -iTCP:$port -sTCP:LISTEN -t &>/dev/null; then
    exit 0
fi

echo "Opening SSH tunnel for $db..."

# Refresh expired vault token non-interactively via userpass before any
# call that needs it. Avoids the "broken connect" path where curl to eva
# silently 403s and evaql ends up prompting in a tmux pane that nvim can't
# see. Requires VAULT_USER + VAULT_PASS already in env (set in ~/.env).
ensure_vault_token() {
    command -v vault &>/dev/null || return 0
    vault token lookup &>/dev/null && return 0
    # Try renewing an existing-but-near-expiry token first (cheap).
    vault token renew &>/dev/null && return 0
    # Re-login. Userpass only — extend if you ever switch methods.
    if [[ -n "${VAULT_USER:-}" && -n "${VAULT_PASS:-}" ]]; then
        local token
        token=$(vault login -token-only -method=userpass \
            username="$VAULT_USER" password="$VAULT_PASS" 2>/dev/null) || return 1
        [[ -n "$token" ]] || return 1
        export VAULT_TOKEN="$token"
        # Persist for other shells (vault CLI's default cache path).
        umask 077
        printf '%s' "$token" > ~/.vault-token
        echo "vault: refreshed token via userpass" >&2
        return 0
    fi
    echo "vault: token expired and VAULT_USER/VAULT_PASS not set — run 'vault login -method=userpass username=<you>' manually" >&2
    return 1
}

# Auto-accept unknown SSH host keys for the target server
if command -v vault &>/dev/null; then
    ensure_vault_token || true
    tunnel_ip=$(curl -ss "https://eva.vidangel.us/product/$domain/$env" \
        -H "X-Vault-Token: $(vault print token)" --fail 2>/dev/null | awk '{print $1}')
    if [[ -n "$tunnel_ip" ]] && ! ssh-keygen -F "$tunnel_ip" &>/dev/null; then
        echo "Adding host key for $tunnel_ip..."
        ssh-keyscan -t ed25519,rsa "$tunnel_ip" 2>/dev/null >> ~/.ssh/known_hosts
    fi
fi

session=tunnels
cmd="evaql $domain $env; echo 'Tunnel closed. Press enter to exit.'; read"

# Build -e flags so the new pane inherits this shell's auth env even if
# the existing tmux session was created without it.
env_flags=()
for key in VAULT_ADDR VAULT_NAMESPACE VAULT_TOKEN VAULT_USER VAULT_PASS; do
    val="${!key:-}"
    [[ -n "$val" ]] && env_flags+=("-e" "$key=$val")
done

prune_dead_panes() {
    command tmux has-session -t "$session" 2>/dev/null || return 0
    # Pids currently holding any tunnel port (global lookup — survives
    # re-parented ssh procs that aren't direct children of the pane shell).
    local tunnel_pids
    tunnel_pids=$( {
        lsof -nP -iTCP:24601 -sTCP:LISTEN -t 2>/dev/null || true
        lsof -nP -iTCP:24602 -sTCP:LISTEN -t 2>/dev/null || true
        lsof -nP -iTCP:24603 -sTCP:LISTEN -t 2>/dev/null || true
        lsof -nP -iTCP:24604 -sTCP:LISTEN -t 2>/dev/null || true
    } | sort -u)
    while IFS=' ' read -r pane_id pane_pid; do
        # Recursively collect all descendant pids under the pane.
        local descendants="$pane_pid"
        local frontier="$pane_pid"
        while [[ -n "$frontier" ]]; do
            local next=""
            for fp in $frontier; do
                local kids
                kids=$(pgrep -P "$fp" 2>/dev/null || true)
                [[ -n "$kids" ]] && next+=" $kids"
            done
            frontier="$next"
            [[ -n "$next" ]] && descendants+=" $next"
        done
        local keep=0
        for pid in $descendants; do
            for tpid in $tunnel_pids; do
                if [[ "$pid" == "$tpid" ]]; then
                    keep=1; break 2
                fi
            done
        done
        if [[ $keep -eq 0 ]]; then
            command tmux kill-pane -t "$pane_id" 2>/dev/null || true
        fi
    done < <(command tmux list-panes -t "$session" -F '#{pane_id} #{pane_pid}' 2>/dev/null)
}

# Prune dead panes first so the session doesn't fill up.
prune_dead_panes

# Try to add the pane. If split-window fails (no space, dimension limits),
# fall back: nuke the session and start fresh.
spawn_pane() {
    if command tmux has-session -t "$session" 2>/dev/null; then
        command tmux split-window -t "$session" -h "${env_flags[@]}" "$cmd" 2>&1
    else
        command tmux new-session -d -s "$session" -n tunnels "${env_flags[@]}" "$cmd" 2>&1
    fi
}

if ! out=$(spawn_pane); then
    echo "tmux refused: $out — nuking $session and retrying"
    command tmux kill-session -t "$session" 2>/dev/null || true
    spawn_pane
fi

# Quick poll: tunnel often opens in <2s if no auth needed.
for _ in 1 2 3 4 5; do
    sleep 1
    if lsof -iTCP:$port -sTCP:LISTEN -t &>/dev/null; then
        echo "Tunnel open for $db on port $port"
        exit 0
    fi
done

# Still down → likely waiting on interactive auth (vault token / SSH).
# If we're inside tmux, surface the detached session in a popup so the
# user can authenticate. Detaching the popup leaves the tunnel running.
if [[ -n "${TMUX:-}" ]]; then
    echo "Tunnel needs auth — opening attach popup. Detach (prefix-d) when done."
    command tmux display-popup -E -w 90% -h 80% \
        "tmux attach -t $session" || true

    # Poll once more after popup closes
    for _ in 1 2 3 4 5; do
        sleep 1
        if lsof -iTCP:$port -sTCP:LISTEN -t &>/dev/null; then
            echo "Tunnel open for $db on port $port"
            exit 0
        fi
    done
fi

echo "ERROR: Tunnel for $db not open. Run 'evaql $domain $env' manually," >&2
echo "       or 'tmux attach -t $session' to finish authentication." >&2
exit 1
